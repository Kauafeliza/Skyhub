<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="robots" content="noindex,nofollow"/>
<meta name="theme-color" content="#000000"/>
<title>Protected</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
  *{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%;background:#000;color:#f5f5f7;font-family:Inter,system-ui,sans-serif}
  body{
    min-height:100vh;display:flex;align-items:center;justify-content:center;
    background:
      radial-gradient(900px 500px at 15% -10%, rgba(121,92,255,.18), transparent 55%),
      radial-gradient(800px 480px at 90% 110%, rgba(56,107,255,.12), transparent 50%),
      #000;
  }
  .card{
    width:min(440px,92vw);
    border:1px solid rgba(255,255,255,.08);
    border-radius:18px;
    background:rgba(0,0,0,.75);
    backdrop-filter:blur(18px);
    padding:36px 28px 28px;
    text-align:center;
    box-shadow:0 30px 80px rgba(0,0,0,.45);
  }
  .badge{
    display:inline-flex;align-items:center;gap:8px;
    padding:6px 12px;border-radius:999px;
    border:1px solid rgba(255,255,255,.1);
    background:rgba(255,255,255,.04);
    color:#a1a1aa;font-size:11px;font-weight:600;
    letter-spacing:.4px;text-transform:uppercase;margin-bottom:18px;
  }
  .dot{width:7px;height:7px;border-radius:50%;background:#f87171;box-shadow:0 0 10px #f87171}
  h1{
    font-size:clamp(22px,5vw,28px);letter-spacing:-.6px;line-height:1.2;margin-bottom:10px;
  }
  h1 span{
    background:linear-gradient(90deg,#fff,#a994ff);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  p{color:#858591;font-size:13px;line-height:1.6;margin-bottom:22px}
  .msg{
    border:1px solid rgba(169,148,255,.28);
    background:rgba(169,148,255,.08);
    border-radius:12px;
    padding:14px 16px;
    font-weight:700;
    font-size:15px;
    letter-spacing:.2px;
    color:#e9e4ff;
  }
  .foot{margin-top:18px;font-size:11px;color:#52525b}
</style>
</head>
<body>
  <div class="card">
    <div class="badge"><span class="dot"></span> Access denied</div>
    <h1>This resource is <span>protected</span></h1>
    <p>Browser access is blocked. This endpoint only serves authorized runtime requests.</p>
    <div class="msg">Protect by skyling</div>
    <div class="foot">Skyling · server lock</div>
  </div>
  <script>
    // plain text fallback for tools that only read body text
    document.title = "Protect by skyling";
  </script>
</body>
</html>
