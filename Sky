					local horizontal = Vector3.new(vel.X, 0, vel.Z)
					if horizontal.Magnitude > 0.5 then
						local dir = horizontal.Unit
						TPSpart.AssemblyLinearVelocity = vel + (dir * PS_SPEED)
					else
						TPSpart.AssemblyLinearVelocity = vel + (TPSpart.CFrame.LookVector * PS_SPEED)
					end
					TPSpart.CFrame = TPSpart.CFrame + Vector3.new(0, PS_HEIGHT * 0.05, 0)
				end
			end
		end
	end
end)

