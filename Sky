	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.GothamBold
	textLabel.Parent = button

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = button

	local function onTouched(hit)
		if hit and hit.Name == "TPS" and hit:IsA("BasePart") then
			targetPart = hit
		end
	end

	local function setupTouch(char)
		for _, part in pairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				table.insert(AutoBallConnections, part.Touched:Connect(onTouched))
			end
		end
		table.insert(AutoBallConnections, char.DescendantAdded:Connect(function(desc)
			if desc:IsA("BasePart") then
				table.insert(AutoBallConnections, desc.Touched:Connect(onTouched))
			end
		end))
	end

	setupTouch(autoBallChar)

	table.insert(AutoBallConnections, button.MouseButton1Click:Connect(function()
		button.Size = UDim2.new(0, 55, 0, 55)
		task.wait(0.1)
		button.Size = UDim2.new(0, 60, 0, 60)
		startFollowing()
	end))

	local dragging, dragInput, dragStart, startPos = false, nil, nil, nil

	local function updateInput(input)
		local delta = input.Position - dragStart
		button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end

	table.insert(AutoBallConnections, button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = button.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end))

	table.insert(AutoBallConnections, button.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end))

	table.insert(AutoBallConnections, UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			updateInput(input)
		end
	end))

	table.insert(AutoBallConnections, UserInputService.TouchMoved:Connect(function(touch)
		if dragging then
			updateInput(touch)
		end
	end))

	table.insert(AutoBallConnections, LocalPlayer.CharacterAdded:Connect(function(newCharacter)
		autoBallChar = newCharacter
		autoBallHum = newCharacter:WaitForChild("Humanoid")
		autoBallRoot = newCharacter:WaitForChild("HumanoidRootPart")
		setupTouch(newCharacter)
		if isFollowing then
			stopFollowing()
			task.wait(0.5)
			startFollowing()
		end
	end))

	table.insert(AutoBallConnections, task.spawn(function()
		while AutoBallGui and AutoBallGui.Parent do
			task.wait(3)
			if isFollowing then
				if not targetPart or not targetPart.Parent then
					stopFollowing()
				end
			end
		end
	end))
end

