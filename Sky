		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			joyActive = true
			joyId = input
		end
	end))
	table.insert(TotConnections, UserInputService.InputChanged:Connect(function(input)
		if joyActive and input == joyId then
			local center = zone.AbsolutePosition + zone.AbsoluteSize / 2
			local delta = Vector2.new(input.Position.X, input.Position.Y) - center
			local dist = delta.Magnitude
			local clamped = dist > joyR and delta.Unit * joyR or delta
			thumb.Position = UDim2.new(0.5, clamped.X, 0.5, clamped.Y)
			local n = dist > 0 and (clamped / joyR) or Vector2.zero
			moveDir = Vector3.new(n.X, 0, n.Y)
		end
	end))
	table.insert(TotConnections, UserInputService.InputEnded:Connect(function(input)
		if joyActive and input == joyId then
			joyActive = false
			joyId = nil
			thumb.Position = UDim2.new(0.5, 0, 0.5, 0)
			moveDir = Vector3.zero
		end
	end))
	table.insert(TotConnections, RunService.RenderStepped:Connect(function()
		if not hum then
			return
		end
		if moveDir.Magnitude > 0.05 then
			local cam = Workspace.CurrentCamera.CFrame
			local fwd = Vector3.new(cam.LookVector.X, 0, cam.LookVector.Z)
			if fwd.Magnitude > 0 then
				fwd = fwd.Unit
			end
			local right = Vector3.new(cam.RightVector.X, 0, cam.RightVector.Z)
			if right.Magnitude > 0 then
				right = right.Unit
			end
			local dir = right * moveDir.X + fwd * -moveDir.Z
			if dir.Magnitude > 0 then
				hum:Move(dir, false)
			end
		else
			hum:Move(Vector3.zero, false)
		end
	end))
end

local AutoConfig = {
	ActivationDistance = 20,
	ClickInterval = 0.1,
	TargetName = "TPS",
	ToggleKey = Enum.KeyCode.R,
	ActionKey = "F",
	isActive = false,
}
local autoHB, autoRoot = nil, nil

local function updateAuto(char)
	autoRoot = char:WaitForChild("HumanoidRootPart")
	if AutoConfig.isActive then
		AutoConfig.isActive = false
		if autoHB then
			autoHB:Disconnect()
			autoHB = nil
		end
	end
end
if LocalPlayer.Character then
	updateAuto(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(updateAuto)

local function setAuto(state)
	AutoConfig.isActive = state
	if state then
		if autoHB then
			autoHB:Disconnect()
		end
		autoHB = RunService.Heartbeat:Connect(function()
			if not AutoConfig.isActive or not autoRoot then
				return
			end
			for _, obj in pairs(Workspace:GetChildren()) do
				if obj.Name == AutoConfig.TargetName and obj:IsA("BasePart") then
					if (obj.Position - autoRoot.Position).Magnitude <= AutoConfig.ActivationDistance then
						VirtualInputManager:SendKeyEvent(true, AutoConfig.ActionKey, false, game)
						task.wait(AutoConfig.ClickInterval)
						VirtualInputManager:SendKeyEvent(false, AutoConfig.ActionKey, false, game)
						break
					end
				end
			end
		end)
	else
		if autoHB then
			autoHB:Disconnect()
			autoHB = nil
		end
	end
end

UserInputService.InputBegan:Connect(function(input, gp)
	if gp then
		return
	end
	if input.KeyCode == AutoConfig.ToggleKey then
		setAuto(not AutoConfig.isActive)
	end
end)

