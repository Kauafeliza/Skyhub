local function getClosestTPS()
	local char = LocalPlayer.Character
	if not char then
		return nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local closest, dist = nil, 80
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj.Name == "TPS" then
			local part
			if obj:IsA("Model") then
				part = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
			elseif obj:IsA("BasePart") then
				part = obj
			end
			if part then
				local d = (part.Position - root.Position).Magnitude
				if d < dist then
					dist = d
					closest = obj
				end
			end
		end
	end
	return closest
end

local function startControl(target)
	local part
	if target:IsA("Model") then
		part = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
	else
		part = target
	end
	if not part then
		return
	end
	controlledPart = part
	controlling = true
	if CBGui then
		local b = CBGui:FindFirstChild("SkyLing")
		if b then
			b.BackgroundColor3 = Color3.fromRGB(80, 180, 220)
			b.Text = "Active"
		end
	end
	local look = camera.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	pitch = math.asin(math.clamp(look.Y, -1, 1))
	camera.CameraType = Enum.CameraType.Scriptable

	inputConn = UserInputService.InputChanged:Connect(function(input, processed)
		if processed or not controlling then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			yaw = yaw - input.Delta.X * M_SENS
			pitch = math.clamp(pitch - input.Delta.Y * M_SENS, -1.2, 1.2)
		elseif input.UserInputType == Enum.UserInputType.Touch then
			yaw = yaw - input.Delta.X * T_SENS
			pitch = math.clamp(pitch - input.Delta.Y * T_SENS, -1.2, 1.2)
		end
	end)

	controlConn = RunService.RenderStepped:Connect(function()
		if not controlling or not controlledPart or not controlledPart.Parent then
			stopControl()
			return
		end
		local dir = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0).LookVector
		pcall(function()
			controlledPart.AssemblyLinearVelocity = dir * SPEED
			controlledPart.AssemblyAngularVelocity = Vector3.zero
		end)
		local camPos = controlledPart.Position - dir * CAM_DIST + Vector3.new(0, CAM_H, 0)
		camera.CFrame = CFrame.lookAt(camPos, controlledPart.Position + Vector3.new(0, 1.5, 0))
	end)
end

