--// Check Key
local function CheckKey()
	if TextBox.Text == "Gostoso" then
		Status.TextColor3 = Color3.fromRGB(80, 255, 140)
		Status.Text = "Key accepted!"

		task.wait(0.5)

		TweenService:Create(
			Main,
			TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
			{
				Size = UDim2.new(0, 0, 0, 0),
				Position = UDim2.new(0.5, 0, 0.5, 0)
			}
		):Play()

		task.wait(0.4)
		ScreenGui:Destroy()

		--// COLOQUE SEU SCRIPT AQUI
		-- loadstring(game:HttpGet("SEU_LINK"))()

	else
		Status.TextColor3 = Color3.fromRGB(255, 80, 80)
		Status.Text = "Invalid key!"

		TweenService:Create(
			Main,
			TweenInfo.new(0.08),
			{Position = UDim2.new(0.5, -195, 0.5, -115)}
		):Play()

		task.wait(0.08)

		TweenService:Create(
			Main,
			TweenInfo.new(0.08),
			{Position = UDim2.new(0.5, -185, 0.5, -115)}
		):Play()

		task.wait(0.08)

		TweenService:Create(
			Main,
			TweenInfo.new(0.08),
			{Position = UDim2.new(0.5, -190, 0.5, -115)}
		):Play()
	end
end

Enter.MouseButton1Click:Connect(CheckKey)

TextBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		CheckKey()
	end
end)

--// Mobile / PC Drag
local UserInputService = game:GetService("UserInputService")

local dragging = false
local dragStart
local startPos

Main.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPos = Main.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if dragging and (
		input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
	) then

		local delta = input.Position - dragStart

		Main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)
