	table.insert(CBConnections, btn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = btn.Position
			totalDrag = 0
		end
	end))
	table.insert(CBConnections, btn.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			totalDrag = totalDrag + d.Magnitude
			btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
			dragStart = input.Position
			startPos = btn.Position
		end
	end))
	table.insert(CBConnections, btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
			if totalDrag < 15 then
				if controlling then
					stopControl()
				else
					local found = getClosestTPS()
					if found then
						startControl(found)
					end
				end
			end
		end
	end))
end

local PredictEnabled = false
local PredictionTime = 0.35
local TPS = nil

local Line = Drawing.new("Line")
Line.Visible = false
Line.Thickness = 2
Line.Transparency = 1
Line.Color = Color3.fromRGB(255, 60, 60)

local Dot = Drawing.new("Circle")
Dot.Visible = false
Dot.Filled = true
Dot.Radius = 6
Dot.Transparency = 1
Dot.Color = Color3.fromRGB(255, 60, 60)

local function FindTPS()
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj.Name == "TPS" and obj:IsA("BasePart") then
			return obj
		end
	end
	return nil
end

RunService.RenderStepped:Connect(function()
	if not PredictEnabled then
		Line.Visible = false
		Dot.Visible = false
		return
	end
	if not TPS or not TPS.Parent then
		TPS = FindTPS()
	end
	if not TPS then
		Line.Visible = false
		Dot.Visible = false
		return
	end
	local velocity = TPS.AssemblyLinearVelocity
	local predictedPosition = TPS.Position + velocity * PredictionTime
	local currentPos, currentVisible = camera:WorldToViewportPoint(TPS.Position)
	local predictedPos, predictedVisible = camera:WorldToViewportPoint(predictedPosition)
	if currentVisible and predictedVisible then
		Line.From = Vector2.new(currentPos.X, currentPos.Y)
		Line.To = Vector2.new(predictedPos.X, predictedPos.Y)
		Line.Visible = true
		Dot.Position = Vector2.new(predictedPos.X, predictedPos.Y)
		Dot.Visible = true
	else
		Line.Visible = false
		Dot.Visible = false
	end
end)

local AutoBallGui = nil
local AutoBallConnections = {}
local isFollowing = false
local followConnection = nil
local targetPart = nil
local originalWalkSpeed = 16
local originalJumpPower = 50
local autoBallChar = LocalPlayer.Character
local autoBallHum = autoBallChar and autoBallChar:FindFirstChildOfClass("Humanoid")
local autoBallRoot = autoBallChar and autoBallChar:FindFirstChild("HumanoidRootPart")

local function stopFollowing()
	if followConnection then
		followConnection:Disconnect()
		followConnection = nil
	end
	isFollowing = false
	if AutoBallGui then
		local btn = AutoBallGui:FindFirstChild("AutoFollowButton")
		if btn then
			btn.BackgroundColor3 = Color3.new(0, 0, 0)
		end
	end
	if autoBallHum then
		autoBallHum.WalkSpeed = originalWalkSpeed
		autoBallHum.JumpPower = originalJumpPower
		if autoBallRoot then
			autoBallHum:MoveTo(autoBallRoot.Position)
		end
	end
end

local function startFollowing()
	if not targetPart or not targetPart.Parent then
		return
	end
	if isFollowing then
		stopFollowing()
		return
	end
	isFollowing = true
	if AutoBallGui then
		local btn = AutoBallGui:FindFirstChild("AutoFollowButton")
		if btn then
			btn.BackgroundColor3 = Color3.new(0.3, 0.3, 0.3)
		end
	end
	if autoBallHum then
		originalWalkSpeed = autoBallHum.WalkSpeed
		originalJumpPower = autoBallHum.JumpPower
	end
	local lastMoveTime = tick()
	local stuckCounter = 0
	followConnection = RunService.Heartbeat:Connect(function()
		if not targetPart or not targetPart.Parent then
			stopFollowing()
			return
		end
		if not autoBallChar or not autoBallChar.Parent then
			stopFollowing()
			return
		end
		if not autoBallHum or not autoBallRoot then
			return
		end
		local targetPosition = targetPart.Position
		local currentPosition = autoBallRoot.Position
		local distance = (targetPosition - currentPosition).Magnitude
		if distance > 0.5 then
			autoBallHum:MoveTo(targetPosition)
			local currentTime = tick()
			if currentTime - lastMoveTime > 0.5 then
				local newPos = autoBallRoot.Position
				if (newPos - currentPosition).Magnitude < 0.1 then
					stuckCounter = stuckCounter + 1
					if stuckCounter > 3 then
						autoBallHum.Jump = true
						stuckCounter = 0
					end
				else
					stuckCounter = 0
				end
				lastMoveTime = currentTime
			end
			autoBallHum.WalkSpeed = originalWalkSpeed
		else
			autoBallHum:MoveTo(targetPosition + Vector3.new(1, 0, 1))
			autoBallHum.WalkSpeed = originalWalkSpeed
		end
	end)
end

